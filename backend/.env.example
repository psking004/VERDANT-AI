# Copy to backend/.env (loaded automatically by server.py). Never commit the real .env.
# MongoDB connection (dev default: mongodb://localhost:27017)
MONGO_URL=
# Database name (dev default: verdant_ai)
DB_NAME=
# Comma-separated allowed origins, e.g. https://your-frontend.example.com (default * = allow all)
CORS_ORIGINS=
# Farm location for weather + pest risk (Open-Meteo, no API key needed).
# Default: Moranapalli, Hosur, Tamil Nadu (12.73, 77.78)
FARM_LAT=
FARM_LON=
FARM_LOCATION_NAME=
# Stripe secret key (sk_test_... / sk_live_...) — needed for marketplace checkout
STRIPE_API_KEY=
# Stripe webhook signing secret (whsec_...) — needed for /api/webhook/stripe
STRIPE_WEBHOOK_SECRET=
# Optional: public frontend URL for Stripe success/cancel redirects (default: origin sent by the browser)
PUBLIC_APP_URL=
# Port for `python server.py` (default 8001; most hosts set this)
PORT=
# Optional: path to the React build to serve (default ../frontend/build)
FRONTEND_BUILD_DIR=
